# Optional: only needed if you want Google Maps provider.
# Without this key, the app automatically falls back to no-key map tiles.
GOOGLE_MAPS_API_KEY = "your-restricted-browser-key"

# Optional Ollama overrides (AI Procedure uses Ollama as primary LLM).
OLLAMA_BASE_URL = "http://127.0.0.1:11434"
OLLAMA_MODEL = "llama3.1:8b"

# Optional fallback callable for non-Ollama advisory integration.
# Format: "module.submodule:function_name"
# LLM_ADVISOR_CALLABLE = "llm_agent:generate_ai_procedure"
